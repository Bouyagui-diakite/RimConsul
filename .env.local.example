# AfroConsul — Supabase configuration
# Copy this file to ".env.local" and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Restart `npm run dev` after editing.

# Project URL (looks like https://abcdefghijklmnop.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (a long JWT, also shown as "anon public" / "publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. NEVER prefix with NEXT_PUBLIC. Used for admin/server tasks.
# (also shown as "service_role" / "secret key")
SUPABASE_SERVICE_ROLE_KEY=
